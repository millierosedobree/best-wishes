# Copy to .env and set a long random string. Required for saving from the admin UI and uploads.
ADMIN_TOKEN=change-me-to-a-secret-string

# Optional (default 3333)
# PORT=3333

# Optional persistent storage root for Railway Volumes.
# Example: DATA_ROOT=/data
# When set, uploaded files and editable shows.json are stored there instead of in the app folder.
# DATA_ROOT=/data
